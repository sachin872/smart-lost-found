# ==========================================
# BACKEND ENVIRONMENT VARIABLES (server/.env)
# ==========================================
PORT=5000
NODE_ENV=development

# MongoDB Atlas Persistent Database Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_lost_found?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_change_in_production_2026_xyz
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Matching Configuration / External AI Service (Optional)
AI_API_KEY=
AI_SERVICE_URL=
CLIENT_URL=http://localhost:5173

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (client/.env)
# ==========================================
VITE_API_URL=/api
